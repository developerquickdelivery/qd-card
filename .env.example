# ==============================================================
# QuickCard Ethiopia - Production Environment Configuration
# ==============================================================

# Node Environment ('production' enables caching and security headers)
NODE_ENV=production

# Application Port (default: 3000)
PORT=3000

# Network Host Binding ('0.0.0.0' binds to all interfaces in Docker/Cloud)
HOST=0.0.0.0

# Base Public URL (used for QR code encoding and short links)
# e.g., https://qc.et or https://quickcard.example.com
BASE_URL=http://localhost:3000
